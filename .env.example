# =============================================================================
# VLM-IDP Research Project — Environment Configuration Template
# Copy this file to '.env' and adjust paths for your local machine.
# NEVER commit the active '.env' file or any secrets to version control.
# =============================================================================

# Paths & Directories
PROJECT_ROOT=.
DATA_ROOT=./data
ARTIFACT_ROOT=./experiments
LOG_DIR=./logs

# Model & HuggingFace Cache Locations
HF_HOME=~/.cache/huggingface
TRANSFORMERS_CACHE=~/.cache/huggingface/hub
MODEL_CACHE_DIR=~/.cache/vlm_models

# Runtime & Logging Configuration
LOG_LEVEL=INFO
PYTHONHASHSEED=42
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Experiment Tracking (Offline/Disabled for Reproducibility by Default)
WANDB_MODE=disabled
MLFLOW_TRACKING_URI=
